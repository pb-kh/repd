#!/bin/sh
# Test stub: logs the call and emulates useradd inside $REPD_SYSROOT.
set -eu
echo "useradd $*" >> "$REPD_SYSROOT/stub.log"
shell=/bin/sh groups=""
while [ $# -gt 1 ]; do
  case "$1" in
    -m) shift ;;
    -s) shell="$2"; shift 2 ;;
    -G) groups="$2"; shift 2 ;;
    *) shift ;;
  esac
done
name="$1"
mkdir -p "$REPD_SYSROOT/etc"
touch "$REPD_SYSROOT/etc/passwd" "$REPD_SYSROOT/etc/group"
if grep -q "^$name:" "$REPD_SYSROOT/etc/passwd"; then echo "useradd: user '$name' already exists" >&2; exit 9; fi
echo "$name:x:2000:2000::/home/$name:$shell" >> "$REPD_SYSROOT/etc/passwd"
[ -n "$groups" ] && exec "$(dirname "$0")/usermod" -a -G "$groups" "$name"
exit 0
