# Maintainer: repd developers
# Split package: the core binary and the first-party backend add-ons ship
# separately (research R17); the core works with zero add-ons.
pkgbase=repd
pkgname=(repd repd-pacman repd-systemd repd-openrc repd-yay repd-flatpak)
pkgver=0.1.0
pkgrel=1
pkgdesc='Declarative, reproducible environment configuration in Lua'
arch=(x86_64 aarch64)
url='https://example.invalid/repd'
license=(MIT)
makedepends=(meson ninja python)
source=("repd-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "repd-$pkgver"
  meson subprojects download
  arch-meson build --wrap-mode=nodownload -Dtest_hooks=false -Daddons=enabled -Dplugin_dir=/usr/lib/repd
  meson compile -C build
}

check() {
  cd "repd-$pkgver"
  meson test -C build --suite unit --suite lua
}

_install_into() {
  cd "$srcdir/repd-$pkgver"
  DESTDIR="$srcdir/staging" meson install -C build --no-rebuild >/dev/null
}

package_repd() {
  depends=(glibc)
  optdepends=('repd-pacman: package management via pacman'
              'repd-systemd: service management via systemd'
              'repd-openrc: service management via OpenRC'
              'repd-yay: repo and AUR packages via yay'
              'repd-flatpak: flatpak apps, system-wide and per user')
  _install_into
  install -Dm755 "$srcdir/staging/usr/bin/repd" "$pkgdir/usr/bin/repd"
  install -Dm644 "$srcdir/staging/usr/include/repd/plugin.h" "$pkgdir/usr/include/repd/plugin.h"
  install -Dm644 docs/lua-api.md "$pkgdir/usr/share/doc/repd/lua-api.md"
}

package_repd-pacman() {
  pkgdesc='repd packages backend for pacman'
  depends=(repd pacman)
  _install_into
  install -Dm755 "$srcdir/staging/usr/lib/repd/librepd-pacman.so" "$pkgdir/usr/lib/repd/librepd-pacman.so"
}

package_repd-systemd() {
  pkgdesc='repd services backend for systemd'
  depends=(repd systemd)
  _install_into
  install -Dm755 "$srcdir/staging/usr/lib/repd/librepd-systemd.so" "$pkgdir/usr/lib/repd/librepd-systemd.so"
}

package_repd-openrc() {
  pkgdesc='repd services backend for OpenRC'
  depends=(repd openrc)
  _install_into
  install -Dm755 "$srcdir/staging/usr/lib/repd/librepd-openrc.so" "$pkgdir/usr/lib/repd/librepd-openrc.so"
}

package_repd-yay() {
  pkgdesc='repd packages backend for yay (repo and AUR packages)'
  depends=(repd yay)
  _install_into
  install -Dm755 "$srcdir/staging/usr/lib/repd/librepd-yay.so" "$pkgdir/usr/lib/repd/librepd-yay.so"
}

package_repd-flatpak() {
  pkgdesc='repd packages backends for flatpak (system and per-user installations)'
  depends=(repd flatpak)
  _install_into
  install -Dm755 "$srcdir/staging/usr/lib/repd/librepd-flatpak.so" "$pkgdir/usr/lib/repd/librepd-flatpak.so"
}
