option('test_hooks', type: 'boolean', value: false,
  description: 'Compile in REPD_SYSROOT / REPD_TEST_ASSUME_ROOT hooks (dev/CI builds only)')
option('plugin_dir', type: 'string', value: '/usr/lib/repd',
  description: 'System directory searched for librepd-<name>.so backend plugins (e.g. /usr/lib64/repd on Fedora)')
option('addons', type: 'feature', value: 'auto',
  description: 'Build the first-party backend add-ons (pacman, systemd)')
